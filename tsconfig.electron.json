{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true
  },
  "include": ["electron/**/*.ts", "shared/**/*.ts"],
  "exclude": [
    "electron/**/*.test.ts",
    "electron/**/*.spec.ts",
    "shared/**/*.test.ts",
    "shared/**/*.spec.ts"
  ]
}
