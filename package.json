{
  "name": "aria-app",
  "productName": "Aria",
  "private": true,
  "version": "0.1.1",
  "description": "Aria — Astro-native visual builder",
  "author": "Statice Origins Inc",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ariabuilder/ariabuilder.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "dist-electron/main.mjs",
  "scripts": {
    "dev": "npm run build:electron && node scripts/dev.mjs",
    "build:electron": "node scripts/build-electron.mjs",
    "build:composer-kernel": "node scripts/build-electron.mjs --composer-kernel-only",
    "smoke:project": "node scripts/smoke-project.mjs",
    "smoke:runtime": "node scripts/smoke-runtime.mjs",
    "smoke:git": "node scripts/smoke-git.mjs",
    "smoke:real-astro": "node scripts/smoke-real-astro.mjs",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "build": "npm run typecheck && vite build && npm run build:electron && electron-builder --publish never",
    "dist:linux": "npm run typecheck && vite build && npm run build:electron && electron-builder --linux --publish never",
    "dist:win": "npm run typecheck && vite build && npm run build:electron && electron-builder --win --publish never",
    "dist:mac": "npm run typecheck && vite build && npm run build:electron && electron-builder --mac --arm64 --x64 --publish never",
    "dist:mac:arm64": "npm run typecheck && vite build && npm run build:electron && electron-builder --mac --arm64 --publish never",
    "dist:mac:x64": "npm run typecheck && vite build && npm run build:electron && electron-builder --mac --x64 --publish never",
    "smoke:installed": "node scripts/smoke-installed.mjs",
    "verify:release-signing": "node scripts/verify-release-signing.mjs",
    "typecheck": "npm run paraglide && npm run typecheck:renderer && npm run typecheck:electron && npm run typecheck:tests && npm run typecheck:config",
    "typecheck:renderer": "vue-tsc --noEmit",
    "typecheck:electron": "tsc -p tsconfig.electron.json --noEmit",
    "typecheck:tests": "vue-tsc -p tsconfig.tests.json --noEmit",
    "typecheck:config": "tsc -p tsconfig.node.json --noEmit",
    "check:architecture": "node scripts/check-electron-architecture.mjs",
    "check:test-architecture": "node scripts/check-test-architecture.mjs",
    "paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations --strategy localStorage preferredLanguage baseLocale",
    "electron:install": "node node_modules/electron/install.js",
    "postinstall": "node scripts/ensure-node-pty-perms.mjs",
    "preview": "vite preview",
    "icons:generate": "node scripts/generate-app-icons.mjs",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs",
    "licenses:check": "node scripts/generate-third-party-notices.mjs --check",
    "test:prepare": "npm run paraglide && npm run build:composer-kernel && npm run electron:install",
    "test:unit": "npm run test:prepare && vitest run --project=shared --project=electron --project=renderer --project=scripts",
    "test:shared": "npm run test:prepare && vitest run --project=shared",
    "test:electron": "npm run test:prepare && vitest run --project=electron",
    "test:renderer": "npm run test:prepare && vitest run --project=renderer",
    "test:contracts": "npm run test:prepare && vitest run --project=contracts",
    "test:integration": "npm run test:prepare && vitest run --project=integration",
    "test:all": "npm run test:prepare && vitest run",
    "test:composer": "npm run test:prepare && vitest run shared/composer electron/composer src/workspace/composer",
    "test:fast": "npm run typecheck && npm run check:architecture && npm run check:test-architecture && npm run test:all && npm run smoke:project && npm run smoke:runtime && npm run smoke:git",
    "test": "npm run test:fast && npm run build && npm run smoke:packaged",
    "audit:production": "npm audit --omit=dev --audit-level=low"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.36",
    "@ai-sdk/google": "^4.0.39",
    "@ai-sdk/openai": "^4.0.41",
    "@astrojs/compiler": "^4.0.0",
    "@astrojs/language-server": "^2.16.13",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/vue": "^1.0.7",
    "@iconify/utils": "^3.1.4",
    "@lucide/vue": "^1.29.0",
    "@tanstack/vue-table": "^8.21.3",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/extension-placeholder": "^3.29.2",
    "@tiptap/extension-underline": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@tiptap/vue-3": "^3.29.2",
    "@vueuse/core": "^14.4.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^7.0.64",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "colord": "^2.9.3",
    "electron-updater": "^6.8.9",
    "fast-xml-parser": "^5.10.1",
    "isomorphic-dompurify": "^3.22.0",
    "js-yaml": "^4.3.1",
    "jszip": "^3.10.1",
    "marked": "^18.0.9",
    "morphdom": "^2.7.8",
    "node-pty": "^1.1.0",
    "reka-ui": "^2.10.1",
    "smol-toml": "^1.8.0",
    "tailwind-merge": "^3.6.0",
    "tinyglobby": "^0.2.17",
    "typescript": "~5.8.3",
    "vue": "^3.5.41",
    "vue-sonner": "^2.0.9",
    "vuedraggable": "^4.1.0",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@inlang/paraglide-js": "^2.23.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/dompurify": "^3.0.5",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^27.0.0",
    "@types/jszip": "^3.4.0",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12",
    "generate-license-file": "^4.2.1",
    "jsdom": "^30.0.1",
    "shadcn": "^4.16.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^7.0.4",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  },
  "build": {
    "appId": "com.ariabuilder.app",
    "productName": "Aria",
    "copyright": "Copyright © Statice Origins Inc",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "publish": {
      "provider": "github",
      "owner": "ariabuilder",
      "repo": "ariabuilder",
      "releaseType": "draft"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icons/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "legal/LICENSE"
      },
      {
        "from": "NOTICE",
        "to": "legal/NOTICE"
      },
      {
        "from": "acknowledgements.md",
        "to": "legal/acknowledgements.md"
      },
      {
        "from": "THIRD_PARTY_NOTICES.txt",
        "to": "legal/THIRD_PARTY_NOTICES.txt"
      },
      {
        "from": "node_modules/electron/dist/LICENSE",
        "to": "legal/LICENSE.electron.txt"
      },
      {
        "from": "node_modules/electron/dist/LICENSES.chromium.html",
        "to": "legal/LICENSES.chromium.html"
      }
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**",
      "**/node_modules/@astrojs/compiler/**",
      "**/node_modules/@astrojs/language-server/**",
      "**/dist-electron/composer-kernel.mjs"
    ],
    "mac": {
      "icon": "build/icons/icon.icns",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "notarize": true,
      "target": [
        {
          "target": "dmg"
        },
        {
          "target": "zip"
        }
      ]
    },
    "win": {
      "icon": "build/icons/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "icon": "build/icons/icon.png",
      "category": "Development",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
