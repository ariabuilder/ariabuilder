---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogPost from '../components/BlogPost.astro';

const posts = [
  { title: 'Hello Astro', href: '/blog/hello' },
  { title: 'Shipping fast', href: '/blog/shipping' },
];
---
<BaseLayout title="Blog">
  <main class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-4xl font-bold">Blog</h1>
    <p class="mt-2 text-slate-600">Latest writing from the team.</p>
    <ul class="mt-10 space-y-6">
      {posts.map((post) => (
        <li>
          <BlogPost title={post.title} href={post.href} />
        </li>
      ))}
    </ul>
  </main>
</BaseLayout>
